{
  "manifest_version": 3,
  "name": "HeraAi",
  "version": "1.12.4",
  "minimum_chrome_version": "114",
  "description": "Multi-provider AI assistant for Chrome Side Panel with Gemini, OpenRouter Free, and Ollama Cloud.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://api.tavily.com/*",
    "https://openrouter.ai/*",
    "https://ollama.com/*",
    "https://*.firebaseio.com/*",
    "https://*.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open Hera Ai",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
