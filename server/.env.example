# Zorunlu: Gemini API anahtarlari (virgulle birden fazla)
# Geriye donuk uyumluluk icin GEMINI_API_KEY de kullanilabilir.
# Ornek: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=your_gemini_api_key_here

# Opsiyonel: Tavily API anahtarlari (virgulle birden fazla)
# Sadece Web Research modu icin. Girilmezse /api/research kullanilamaz.
# Geriye donuk: TAVILY_API_KEY
TAVILY_API_KEYS=your_tavily_api_key_here

# Port (default: 3001)
PORT=3001

# Virgulle ayrilmis origin listesi
# Development: http://localhost:5173
# Production: chrome-extension://ID
ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*

# Ortam
NODE_ENV=development

# --- Cooldown sureleri (milisaniye, istege bagli) ---
# Rate limit (429) sonrasi bekleme: 60 saniye
COOLDOWN_RATE_LIMIT=60000

# Kota asimi sonrasi bekleme: 1 saat
COOLDOWN_QUOTA=3600000

# Timeout sonrasi bekleme: 30 saniye
COOLDOWN_TIMEOUT=30000

# 5xx sunucu hatasi sonrasi bekleme: 60 saniye
COOLDOWN_SERVER_ERROR=60000
