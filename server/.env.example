# Port (default: 3001)
PORT=3001

# Comma-separated origin list
# Development: http://localhost:5173
# Production: chrome-extension://ID
ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*

# Environment
NODE_ENV=development

# --- Cooldown durations (milliseconds, optional) ---
# Rate limit (429) wait: 60 seconds
COOLDOWN_RATE_LIMIT=60000

# Quota exceeded wait: 1 hour
COOLDOWN_QUOTA=3600000

# Timeout wait: 30 seconds
COOLDOWN_TIMEOUT=30000

# 5xx server error wait: 60 seconds
COOLDOWN_SERVER_ERROR=60000
