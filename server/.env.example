# Zorunlu: Normal chat ve vision/translate islemleri icin
GEMINI_API_KEY=your_gemini_api_key_here

# Opsiyonel: Sadece Web Research modu icin gereklidir.
# Girilmezse /api/research endpoint'i kullanilamaz, chat ve vision calisir.
TAVILY_API_KEY=your_tavily_api_key_here

# Port (default: 3001)
PORT=3001

# Virgulle ayrilmis origin listesi. Development: http://localhost:5173
# Production: Chrome extension ID'nizi ekleyin, orn:
# chrome-extension://abcdefghijklmnopqrstuvwxyz123456
ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*

# development veya production
NODE_ENV=development
