# Firebase web konfigurasyonu.
# Firebase Console -> Project settings -> General -> Your apps -> Web app degerlerini
# .env.local dosyasina yazin; .env.local Git'e alinmaz.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud Console -> Google Auth Platform -> Clients -> OAuth client ID
# (Application type: Web application)
# Authorized redirect URI olarak chrome.identity.getRedirectURL() ciktisi eklenmelidir:
#   https://<uzanti-id>.chromiumapp.org/
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Set only after deploying cloudGateway. Blank preserves the private legacy transport.
# Public builds must set this; use firebase.gateway.json for gateway-only rules.
VITE_CLOUD_GATEWAY_URL=
